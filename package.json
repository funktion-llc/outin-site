{
  "name": "outin-site",
  "private": true,
  "version": "0.1.0",
  "description": "OUTIN public site + client hub (static phase).",
  "scripts": {
    "dev": "npx --yes serve .",
    "validate": "npx --yes html-validate \"**/*.html\"",
    "check:meta": "node -e \"const fs=require('fs');for(const f of ['client/index.html']){const s=fs.readFileSync(f,'utf8');if(!s.includes('<title>'))process.exit(1)}console.log('meta ok')\""
  },
  "devDependencies": {
    "html-validate": "^8.0.0",
    "serve": "^14.2.0"
  }
}
